# ==============================================================================
# AI Service Environment Configuration Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8083
SPRING_APPLICATION_NAME=ai-service

# Database Configuration (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_vector_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AI & RAG Configuration
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
AI_CHAT_MODEL=gpt-4o-mini
AI_SIMILARITY_THRESHOLD=0.7
AI_TOP_K=5

# LLM API Key (optional - fallback semantic generation enabled if absent)
AI_API_KEY=your_openai_or_compatible_api_key_here

# Eureka Service Discovery
EUREKA_HOSTNAME=localhost
EUREKA_SERVICE_URL=http://localhost:8761/eureka/

# Actuator & Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
